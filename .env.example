# Copy this file to .env and fill in your values.
# The .env file is gitignored and never committed.

# ── Local Docker development (matches docker-compose.yml defaults) ──
DATABASE_URL=postgresql+asyncpg://loan_user:loan_pass@localhost:5432/loan_tracker

# ── Neon (staging / production) ──
# Get the connection string from: Neon Console → your project → Connection Details
# Select "SQLAlchemy" driver and copy the URL, then change "postgresql" → "postgresql+asyncpg"
# DATABASE_URL=postgresql+asyncpg://<user>:<password>@<endpoint>.neon.tech/<dbname>?ssl=require

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET
TOKEN_EXPIRE_DAYS=7

# ── CORS ──────────────────────────────────────────────────────────────────────
# URL where the frontend is deployed (no trailing slash). Leave empty for local dev.
FRONTEND_ORIGIN=https://your-frontend.vercel.app

# ── Production mode ───────────────────────────────────────────────────────────
# Must be false in production. DEBUG=true + SMTP configured = startup failure (by design).
DEBUG=false

# ── Brevo (email for OTP codes) ───────────────────────────────────────────────
# Sign up free at brevo.com → Settings → API Keys
# Then add your Gmail as a verified sender: Settings → Senders & IP → Senders
BREVO_API_KEY=your-brevo-api-key
EMAIL_FROM=your-verified-email@gmail.com
EMAIL_FROM_NAME=מעקב הלוואות
